{
  "appId": "io.github.eclipse_mindlab.garden",
  "appName": "소크라텃밭",
  "webDir": "www",
  "android": { "backgroundColor": "#1d1838" },
  "ios": { "backgroundColor": "#1d1838", "contentInset": "never" },
  "plugins": {
    "FirebaseAuthentication": { "skipNativeAuth": true, "providers": ["google.com"] },
