// 꼬마 철학자의 정원: 기존 딜렘 규칙의 `match /databases/{database}/documents { ... }` 안에 이 두 블록을 "추가"하세요.
// 기존 users 규칙은 건드리지 않습니다.

    // 내 정원 저장본: 나만 읽고 씀
    match /garden/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.s is string && request.resource.data.s.size() < 200000;
    }

    // 주간 리그: 로그인한 사람은 다 읽고, 자기 줄만 씀
    match /gardenLeague/{week}/p/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['name', 'n', 'upd', 'sc'])
        && (!('sc' in request.resource.data) || request.resource.data.sc in ['', 'soc', 'nie', 'dio', 'epi'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 10
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 70;
    }

    // 앱 베타 신청: 자기 신청서만 쓰고 읽음. 명단은 Firebase 콘솔에서 봄
    match /gardenBeta/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'os', 'at'])
        && request.resource.data.email == request.auth.token.email;
    }

    // 광장: 오늘의 질문에 한 줄 답. 로그인한 사람은 다 읽고, 자기 답만 쓰고 지움. 남의 답에는 공감·신고 1씩만 더할 수 있음
    match /gardenTalk/{day}/a/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['t', 'sc', 'name', 'likes', 'rep', 'at'])
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 80
        && request.resource.data.likes == 0 && request.resource.data.rep == 0;
      allow update: if request.auth != null && request.auth.uid != uid
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) && request.resource.data.likes == resource.data.likes + 1)
         || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rep']) && request.resource.data.rep == resource.data.rep + 1));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
